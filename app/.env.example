# Solana JSON-RPC endpoint the app reads from and sends transactions to.
# Public devnet throttles bursts (HTTP 429); a dedicated devnet RPC makes the live views snappier.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Cluster, used for explorer links, labels and polling cadence: devnet | localnet
NEXT_PUBLIC_CLUSTER=devnet

# Shared Pacer DBC config every launch from /launch goes into.
# Devnet: graduates at 1 SOL, 1% base curve fee + dynamic fee, compounding DAMM v2, 100% LP locked.
# For localnet, create one with `pnpm --filter @pacer/scripts create-config`.
NEXT_PUBLIC_PACER_CONFIG=CAf9Dia6vT3QhLFYxvYB2dHHZGJVHpLVaChYxqhEdSan
